CREATE TABLE avatar_assist_sessions (
	id INTEGER NOT NULL, 
	owner_character_id INTEGER NOT NULL, 
	borrower_character_id INTEGER NOT NULL, 
	avatar_id INTEGER NOT NULL, 
	status VARCHAR(16) NOT NULL, 
	expires_at DATETIME, 
	created_at DATETIME DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	accepted_at DATETIME, 
	ended_at DATETIME, 
	PRIMARY KEY (id), 
	FOREIGN KEY(owner_character_id) REFERENCES characters (id) ON DELETE CASCADE, 
	FOREIGN KEY(borrower_character_id) REFERENCES characters (id) ON DELETE CASCADE, 
	FOREIGN KEY(avatar_id) REFERENCES avatars (id) ON DELETE CASCADE
)


