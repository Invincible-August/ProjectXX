CREATE TABLE technique_research_drafts (
	id INTEGER NOT NULL, 
	character_id INTEGER NOT NULL, 
	phase VARCHAR(32) NOT NULL, 
	label_zh VARCHAR(32) NOT NULL, 
	elements_json TEXT NOT NULL, 
	efficacy VARCHAR(32), 
	element_limit VARCHAR(32), 
	weapon_limit VARCHAR(32), 
	base_json TEXT NOT NULL, 
	affixes_json TEXT NOT NULL, 
	upgrade_points INTEGER NOT NULL, 
	major_rank VARCHAR(32) NOT NULL, 
	conditions_confirmed BOOLEAN NOT NULL, 
	created_at DATETIME DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	updated_at DATETIME DEFAULT (CURRENT_TIMESTAMP) NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(character_id) REFERENCES characters (id) ON DELETE CASCADE
)


