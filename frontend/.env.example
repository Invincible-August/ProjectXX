# 后端 API 前缀（含 /api/v1）
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 健康检查完整 URL（LoginView「检测状态」用）
VITE_HEALTH_URL=http://127.0.0.1:8000/health

# 修炼权威对表兜底最大间隔（毫秒）；默认 120000。主路径按 tick 对齐拉取
VITE_IDLE_POLL_MS=120000

# 修炼客户端预测刷新间隔（毫秒）；默认 250（仅本地片内进度条，不增加 HTTP）
VITE_IDLE_PREDICT_MS=250

# 进大厅若有离线 pending 时是否自动打开领取对话框
VITE_OFFLINE_AUTO_OPEN=true

# 战报播放器自动步进间隔（毫秒；M3）
VITE_BATTLE_PLAYBACK_MS=400

# M4：化身轮询间隔（毫秒；0=不轮询，由页面 onMounted 拉取）
VITE_AVATAR_POLL_MS=0

# M4：工坊本地进度条 tick 间隔（毫秒）
VITE_CRAFT_TICK_MS=1000

# M5：世界环境轮询间隔（毫秒）；顶栏时辰/天气权威校准
VITE_WORLD_POLL_MS=5000

# M5：待引渡倒计时本地刷新间隔（毫秒）
VITE_FERRY_TICK_MS=1000

# M6：WebSocket 地址（缺省由 VITE_API_BASE_URL 推导为 ws://…/api/v1/ws）
VITE_WS_URL=ws://127.0.0.1:8000/api/v1/ws

# M6：是否启用强交互通道（false 时开道/道池仍可用 HTTP；道主挑战入口提示未开启）
VITE_WS_ENABLED=true

# M6：WS 断线重连基础间隔（毫秒；指数退避）
VITE_WS_RECONNECT_MS=2000

# M6：大道 /dao/me 轻量轮询间隔（毫秒；0=不轮询）
VITE_DAO_POLL_MS=0
