# 复制为 .env 后按需修改。真实密钥勿提交仓库。
APP_NAME=ProjectXiuXian
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# M0 本地异步 SQLite；相对路径会锚定到 backend/ 目录（勿依赖启动 cwd）
# 例：sqlite+aiosqlite:///./xiuxian.db  →  backend/xiuxian.db
# 以后可改为 PostgreSQL：postgresql+asyncpg://user:pass@localhost:5432/xiuxian
DATABASE_URL=sqlite+aiosqlite:///./xiuxian.db

# 生产环境请换成足够长的随机串
JWT_SECRET_KEY=change-me-to-a-long-random-secret-for-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
INITIAL_SPIRIT_STONES=1000
REDIS_URL=

# --- ADM 后台管理系统（独立鉴权；勿与玩家 JWT 混用）---
# 留空则派生自 JWT_SECRET_KEY::admin-audience；生产务必单独设置
ADMIN_JWT_SECRET_KEY=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=120
# 库中无管理员时自动创建（开发便利）；生产可关或改密
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# --- 核验与超级密码（verification / super-password）---
# 超级密码：留空表示未启用；仅本地/运维场景，勿提交真实值
SUPER_PASSWORD=
# 身份证核验模式：format | two_factor | real_person（主流程只启用其一）
ID_VERIFY_MODE=format
# 身份证号哈希盐；生产环境务必更换为随机长串
ID_CARD_HASH_SALT=dev-id-salt-change-me
# 短信/邮件发送实现：debug 为本地占位，生产换真实 provider 名
SMS_PROVIDER=debug
EMAIL_PROVIDER=debug
# 二要素 / 实人核验 provider：stub 为占位，生产对接真实服务
ID_TWO_FACTOR_PROVIDER=stub
ID_REAL_PERSON_PROVIDER=stub
# 验证码、票据 TTL（秒）及发送间隔（秒）
VERIFY_CODE_TTL_SECONDS=300
VERIFY_TICKET_TTL_SECONDS=600
VERIFY_SEND_INTERVAL_SECONDS=60
# DEBUG 模式下固定验证码（仅开发联调）
DEBUG_VERIFY_CODE=000000

# --- 注册材料开关（false=不展示/不强制；三者皆 false 则仅邮箱+密码可注册）---
REGISTER_REQUIRE_PHONE=false
REGISTER_REQUIRE_REAL_NAME=false
REGISTER_REQUIRE_EMAIL_CODE=false

# --- M1 挂机 / GM / 突破测试 ---
# 挂机一片时长（秒）；覆盖 idle.yaml 的 tick_seconds（联调可改为 5 加速）
IDLE_TICK_SECONDS=60
# 前端轮询提示（秒）；可选
IDLE_POLL_HINT_SECONDS=5
# GM 接口：development 下默认 true；设 false 即使 development 也返回 40310
GM_ENABLED=true
# 可选白名单：逗号分隔 user_id；留空=任意登录用户可用（仅本地便利）
# GM_ALLOWED_USER_IDS=1
# 突破掷骰种子：仅单测注入，生产勿设（留空）
# BREAKTHROUGH_RNG_SEED=42

# --- M2 离线帽 / 分配 / 体质 / 品阶 ---
OFFLINE_CAP_HOURS_FREE=12
OFFLINE_CAP_HOURS_MEMBER_TIER1=18
OFFLINE_CAP_HOURS_MEMBER_TIER2=24
OFFLINE_PREVIEW_THRESHOLD_SECONDS=300
ALLOCATE_MIN_UNIT=1
CONSTITUTION_UNEQUIP_COOLDOWN_SECONDS=0
# 品阶掷骰种子：仅单测注入（留空）
# GRADE_RNG_SEED=42

# --- M3 战斗成型 / 体力 / 快照 ---
# 体力门禁开关：false 时开战不校验不扣减（联调用），读数接口仍可用
STAMINA_ENABLED=true
# 回合上限覆盖：>0 时覆盖 board.yaml 的 max_rounds（0=不覆盖）
BATTLE_MAX_ROUNDS=0
# 快照手动更新冷却覆盖（秒）：>0 时覆盖 snapshots.yaml（0=不覆盖）
SNAPSHOT_MANUAL_COOLDOWN_SECONDS=0
# 每日定点惰性补刷快照开关
SNAPSHOT_LAZY_DAILY_ENABLED=true
# 演算种子：仅测试注入（写入战报便于复现），生产勿设（留空）
# AUTOCHESS_RNG_SEED=42
# true 时开战必须已有布阵；默认 false 允许本体锚点 (0,3) 临时阵
PVE_REQUIRE_PRESET=false

# --- M4 双线程成长 ---
AVATAR_ENABLED=true
CRAFT_ENABLED=true
PETS_ENABLED=true
DIVINE_SENSE_STRICT=true
M4_GM_GRANT_MATERIALS=true

# --- M5 环境与轮回外环 ---
CALENDAR_ENABLED=true
WEATHER_ENABLED=true
TRIBULATION_ENABLED=true
# 留空则用 calendar.yaml 的 epoch_utc；改 epoch 会平移全日相位
CALENDAR_EPOCH_UTC=
# 0=用 YAML slot_seconds；测时可设 5 加速
CALENDAR_SLOT_SECONDS=0
# memory | redis（多 worker 须 redis；本阶段默认 memory）
WORLD_STATE_BACKEND=memory
# 0=用 reincarnation.yaml ferry_countdown_seconds
FERRY_COUNTDOWN_SECONDS=0
# --- M6 大道 / 道主 / WebSocket ---
DAO_SYSTEM_ENABLED=true
DAO_LORD_ENABLED=true
WS_ENABLED=true
WS_HEARTBEAT_SECONDS=25
WS_IDLE_TIMEOUT_SECONDS=90
# 非空则跨进程 Pub/Sub；空=单进程 Hub
WS_REDIS_URL=
# DEV 默认开骨架事件，便于大厅/道主页测到入口
WORLD_EVENTS_ENABLED=true
# DEV 默认强制挑战开窗（免等时段）
DAO_LORD_FORCE_WINDOW=true
# --- M7 宗门 / 社交 / 经济（L1 起）---
SECT_SYSTEM_ENABLED=true
FRIENDS_SYSTEM_ENABLED=true
TRADE_SYSTEM_ENABLED=true
MAIL_SYSTEM_ENABLED=true
CHAT_SYSTEM_ENABLED=true
CHAT_WS_PUSH_ENABLED=true
HERITAGE_SYSTEM_ENABLED=true
# 0=用 chat_heritage.yaml expire_sec
HERITAGE_EXPIRE_SEC=0
MENTOR_SYSTEM_ENABLED=true
# M7 L7 双修总闸
DUAL_CULTIVATION_ENABLED=true
# M7 L8 商业化 / 天道点沙盒
COMMERCE_SYSTEM_ENABLED=true
COMMERCE_SANDBOX_ENABLED=true
# M7 同图桩：true=社交引渡跳过真区域校验（M9 换真）
SAME_REGION_STUB=true
# 0=用 trade.yaml face_timeout_sec
FACE_TRADE_TIMEOUT_SEC=0
